[Unit]
Description=BSU Math Portal Daily Study Push Reminders
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bsu-math-ai-portal
EnvironmentFile=/home/ubuntu/bsu-math-ai-portal/.env
ExecStart=/home/ubuntu/bsu-math-ai-portal/.venv/bin/python /home/ubuntu/bsu-math-ai-portal/scripts/send_study_reminders.py
Nice=15
