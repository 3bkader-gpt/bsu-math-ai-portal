# Database (SQLite by default, or Supabase PostgreSQL connection string)
DATABASE_URL=sqlite:///./bot_database.db

# Authentication & JWT
# WARNING: no insecure defaults exist anymore — the backend refuses to start
# login/auth on public constants. Always set both vars explicitly.
SECRET_KEY=generate_a_random_secret_jwt_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Admin Cloud Ops (provisioned to the dashboard on successful login; never
# hardcode them in the frontend. ADMIN_MASTER_KEY's SHA-256 must match the
# digest in supabase/migrations/20261024_admin_rpc_sha256_secret.sql)
ADMIN_MASTER_KEY=
GITHUB_DISPATCH_TOKEN=

# Telegram Storage Backend & Telethon CDN
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Supabase Settings (Optional metadata sync)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
